# Maintainer: exomind stack <maintainers@exomind.dev>
# Early Alpha channel: v0.4.0-alpha.1 -> pkgver 040alpha1 (pacman has no
# dashes in pkgver; the tarball used here carries the SAME prefix as its
# internal directory, so makepkg extracts it cleanly).
pkgname=exomind
pkgver=040alpha1
pkgrel=1
pkgdesc="AINSS - AI-Native Software Stack (Early Alpha): memory, scheduling, orchestration, documentation audit, QMS, research, context continuity and the behavioral development kit for AI agents"
arch=('x86_64')
url="https://github.com/bin4ort/exomind"
license=('GPL-3.0-only')
groups=()
depends=('glibc' 'curl')
makedepends=('make' 'gcc' 'coreutils')
checkdepends=()
optdepends=('python: exokit runner shims' 'rust: exokit runner shims' 'nodejs: exokit runner shims')
provides=("$pkgname")
conflicts=()
replaces=()
backup=()
install=
changelog=
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
validpgpkeys=()

build() {
    cd "$srcdir/$pkgname-$pkgver"
    make
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    make test >/dev/null 2>&1
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
